# Auth Service
DATABASE_URL=postgres://crm:crm_secret@localhost:5432/crm_magico?sslmode=disable
REDIS_URL=redis://:crm_redis_secret@localhost:6379/0
JWT_SECRET=change_me_in_production_use_256bit_key_minimum
JWT_EXPIRY=15m
REFRESH_EXPIRY=168h
PORT=8001
ENV=development

# PostgreSQL
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_secret
POSTGRES_DB=crm_magico

# Redis
REDIS_PASSWORD=crm_redis_secret

# Grafana
GF_SECURITY_ADMIN_PASSWORD=crm_grafana_secret
